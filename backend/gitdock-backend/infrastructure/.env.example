# ==============================================================================
# infrastructure — Variables de docker-compose.yml (MODÈLE)
# Copiez ce fichier en .env (dans ce même dossier) et renseignez les valeurs.
# NE JAMAIS commiter .env sur Git !
# Les variables de mot de passe sont obligatoires : docker compose refuse de
# démarrer si elles sont absentes ou vides.
# ==============================================================================

# --- PostgreSQL (auth, project, notification) ---
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- MySQL (gitdock-task) ---
# Doit être identique au mot de passe de DATABASE_URL dans gitdock-task/.env.docker
MYSQL_ROOT_PASSWORD=

# --- MongoDB (et mongo-express) ---
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# --- pgAdmin ---
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
