# ==============================================================================
# gitdock-ai — Variables d'environnement (MODÈLE)
# Copiez ce fichier en .env (dans ce même dossier) et renseignez les valeurs.
# Le service le charge au démarrage (src/core/config.py).
# NE JAMAIS commiter .env sur Git !
# ==============================================================================

# --- Base de données PostgreSQL (lecture des contributions) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gitdock_project
DB_USER=postgres
DB_PASSWORD=

# --- Accès aux plateformes Git ---
GITHUB_TOKEN=
GITLAB_TOKEN=
