# ==============================================================================
# gitdock-yam (FastAPI) — Environnement Docker (NE PAS COMMITER !)
# Ce fichier est chargé par le bloc env_file: du docker-compose.
# ==============================================================================

APP_NAME=gitdock-yam
APP_PORT=8010

# --- Eureka (adresse Docker interne) ---
EUREKA_SERVER_URL=http://gitdock-discovery:8761/eureka/

# --- ChromaDB (adresse Docker interne) ---
CHROMA_HOST=gitdock-chromadb
CHROMA_PORT=8000

# --- Moteur LLM principal ---
# Valeurs possibles : "gemini" | "ollama"
DEFAULT_LLM_PROVIDER=gemini

# --- Gemini (cloud — votre vraie clé API Google AI Studio) ---
GEMINI_API_KEY=***REMOVED***
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama (local — adresse de votre machine Tailscale si applicable) ---
OLLAMA_API_URL=http://ubuntu-host:11434
OLLAMA_MODEL=gemma4:e4b

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Mode simulation (false = appels LLM réels en Docker) ---
DRY_RUN=False
