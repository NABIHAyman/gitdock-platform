# ==============================================================================
# gitdock-task (Symfony) — Environnement Docker (NE PAS COMMITER !)
# ==============================================================================

# 1. MODE DÉVELOPPEMENT ACTIVÉ (Pour voir les erreurs !)
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=***REMOVED***

# 2. BASE DE DONNÉES ET MESSAGERIE (Routage Docker Interne)
DATABASE_URL=mysql://root:root@gitdock-mysql:3306/gitdock_tasks
MESSENGER_TRANSPORT_DSN=amqp://guest:guest@gitdock-rabbitmq:5672/%2f

# 3. COMMUNICATIONS INTER-SERVICES (⚠️ Plus de localhost ici !)
PROJECT_SERVICE_URL=http://***REMOVED***:8083
AUTH_SERVICE_URL=http://***REMOVED***:8081

# 4. MAILS (Laissés à gitdock-notification via RabbitMQ)
MAILER_DSN=null://null

# 5. JWT (Pour décoder les requêtes)
JWT_SECRET_KEY=***REMOVED***
JWT_PUBLIC_KEY=***REMOVED***
JWT_SECRET=***REMOVED***
