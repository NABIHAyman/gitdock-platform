# ==============================================================================
# gitdock-sentinel — Variables d'environnement (MODÈLE)
# Copiez ce fichier en .env (dans ce même dossier) et renseignez les valeurs.
# NE JAMAIS commiter .env sur Git !
#
# Ce fichier sert à deux choses :
#   - le service sentinel lui-même (lancé avec uvicorn, ou via le compose
#     principal qui le lit en env_file) ;
#   - le compose de la stack Sentinel (Kafka, Kafka UI, ChromaDB), qui y lit
#     KAFKA_ADVERTISED_HOST.
# Les valeurs ci-dessous conviennent à un lancement sur une seule machine.
# Dans un conteneur, remplacez localhost par le nom du service Docker.
# ==============================================================================

# --- Service ---
APP_NAME=gitdock-sentinel
APP_PORT=8010

# --- Eureka ---
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# --- ChromaDB (stack Sentinel) ---
CHROMA_HOST=localhost
CHROMA_PORT=8005

# --- Kafka (stack Sentinel) ---
KAFKA_HOST=localhost
KAFKA_PORT=9092
# Adresse que Kafka annonce à ses clients (compose de la stack Sentinel).
# Doit être joignable depuis gitdock-sync et gitdock-sentinel.
KAFKA_ADVERTISED_HOST=localhost

# --- RabbitMQ (stack principale) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=

# --- LLM : Ollama en premier, Gemini en repli ---
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings (SentenceTransformers) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Divers ---
DRY_RUN=false

# --- Scripts (scripts/smart_fetcher.py, scripts/gh_replayer.py) ---
GITHUB_TOKEN=
