# ==============================================================================
# gitdock-project — Variables d'environnement (MODÈLE)
# Copiez ce fichier en .env.local et remplissez vos vraies valeurs.
# NE JAMAIS commiter .env.local sur Git !
# ==============================================================================

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gitdock_project
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JPA / Hibernate ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
SQL_INIT_MODE=always

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Eureka ---
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/

# --- JWT (DOIT ÊTRE IDENTIQUE à gitdock-auth !) ---
JWT_SECRET=CHANGE_ME_same_key_as_gitdock_auth
