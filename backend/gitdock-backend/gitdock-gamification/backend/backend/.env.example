# ==============================================================================
# gitdock-gamification — Variables d'environnement (MODÈLE)
# Copiez ce fichier en .env (dans ce même dossier) et renseignez les valeurs.
# Le compose principal le lit en env_file ; les valeurs surchargent
# appsettings.json (convention .NET : ":" s'écrit "__").
# Les hôtes ci-dessous sont les noms des conteneurs du compose principal.
# NE JAMAIS commiter .env sur Git !
# ==============================================================================

# --- Base de données PostgreSQL ---
# Le mot de passe est celui de POSTGRES_PASSWORD dans infrastructure/.env
ConnectionStrings__DefaultConnection=Host=gitdock-postgres;Port=5432;Database=gitdock_gamification;Username=postgres;Password=

# --- Cache Redis ---
ConnectionStrings__Redis=gitdock-redis:6379

# --- RabbitMQ (MassTransit) ---
RabbitMQ__HostName=gitdock-rabbitmq
RabbitMQ__UserName=guest
RabbitMQ__Password=

# --- Services appelés en HTTP ---
Services__AuthServiceUrl=http://auth-service:8081
Services__ProjectServiceUrl=http://gitdock-project:8083

# --- Eureka (Steeltoe) ---
Eureka__Client__ServiceUrl=http://gitdock-discovery:8761/eureka/
Eureka__Instance__HostName=gitdock-gamification

# --- JWT (DOIT ÊTRE IDENTIQUE à gitdock-auth !) ---
JWT_SECRET=
