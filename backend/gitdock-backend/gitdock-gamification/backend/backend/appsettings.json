{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=gitdock-postgres;Port=5432;Database=gitdock_gamification;Username=postgres;Password=postgres",
    "Redis": "redis:6379"
  },
  "RabbitMQ": {
    "HostName": "gitdock-rabbitmq",
    "UserName": "guest",
    "Password": "guest"
  },
  "Spring": {
    "Application": {
      "Name": "GITDOCK-GAMIFICATION"
    }
  },
  "Eureka": {
    "Client": {
      "ServiceUrl": "http://host.docker.internal:8761/eureka/",
      "ValidateCertificates": false,
      "ShouldRegisterWithEureka": true,
      "ShouldFetchRegistry": true
    },
    "Instance": {
      "AppName": "GITDOCK-GAMIFICATION",
      "Port": 5292,
      "InstanceId": "GITDOCK-GAMIFICATION:5292",
      "PreferIpAddress": true,
      "HostName": "host.docker.internal"
    }
  }
}