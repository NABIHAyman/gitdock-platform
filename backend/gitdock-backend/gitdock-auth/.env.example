# ==============================================================================
# gitdock-auth — Variables d'environnement (MODÈLE)
# Copiez ce fichier en .env.local et remplissez vos vraies valeurs.
# NE JAMAIS commiter .env.local sur Git !
# ==============================================================================

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:5173/oauth/callback/github

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gitdock_auth
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- JPA / Hibernate ---
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
SQL_INIT_MODE=always

# --- Mail (Gmail SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Eureka ---
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/

# --- JWT (générez une clé forte : openssl rand -hex 64) ---
JWT_SECRET=CHANGE_ME_generate_a_strong_secret_with_openssl_rand_hex_64
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- Tokens d'activation ---
ACTIVATION_TOKEN_EXPIRATION=24

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Logs ---
LOG_SECURITY=WARN
